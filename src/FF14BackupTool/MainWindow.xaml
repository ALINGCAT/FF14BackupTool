<Window x:Class="FF14BackupTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FF14 备份工具"
        Icon="Assets/app.ico"
        Width="1240" Height="900" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{StaticResource AppFont}"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="26,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FF14 备份工具" Style="{StaticResource PageTitleStyle}"
                               VerticalAlignment="Center"/>
                    <RadioButton x:Name="BackupPageRadio" Content="备份" Tag="backup"
                                 GroupName="PageMode" Checked="PageRadio_Checked"
                                 Margin="20,0,12,0" VerticalAlignment="Center"/>
                    <RadioButton x:Name="RestorePageRadio" Content="恢复" Tag="restore"
                                 GroupName="PageMode" Checked="PageRadio_Checked"
                                 VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="ThemeSystemRadio" Content="跟随系统" Tag="system"
                                 GroupName="ThemeMode" Checked="ThemeRadio_Checked" Margin="0,0,12,0"/>
                    <RadioButton x:Name="ThemeLightRadio" Content="浅色" Tag="light"
                                 GroupName="ThemeMode" Checked="ThemeRadio_Checked" Margin="0,0,12,0"/>
                    <RadioButton x:Name="ThemeDarkRadio" Content="深色" Tag="dark"
                                 GroupName="ThemeMode" Checked="ThemeRadio_Checked"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="26,14,26,18">
            <Grid x:Name="BackupPage" Visibility="Visible">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,10,0,10">

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="1. 选择游戏目录" Style="{StaticResource SectionTitleStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BackupGamePathBox" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Content="浏览..." Style="{StaticResource SecondaryButtonStyle}"
                                            Click="BrowseBackupGamePath_Click" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="扫描角色" Style="{StaticResource PrimaryButtonStyle}"
                                            Click="ScanBackup_Click"/>
                                </Grid>
                                <TextBlock x:Name="BackupConfigPathText" Style="{StaticResource StatusTextStyle}"
                                           Margin="0,8,0,0" Text="尚未选择目录。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="2. 选择角色与内容" Style="{StaticResource SectionTitleStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Content="全选角色" Style="{StaticResource GhostButtonStyle}"
                                                Click="SelectAllCharacters_Click" Margin="0,0,4,0"/>
                                        <Button Content="全不选" Style="{StaticResource GhostButtonStyle}"
                                                Click="SelectNoCharacters_Click" Margin="0,0,4,0"/>
                                        <Button Content="恢复默认内容" Style="{StaticResource GhostButtonStyle}"
                                                Click="ResetDefaultGroups_Click"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource ListBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,12,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="250"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="62"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="角色" Style="{StaticResource ColumnHeaderStyle}"
                                                       HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="2" Text="最近活动" Style="{StaticResource ColumnHeaderStyle}"/>
                                            <TextBlock Grid.Column="3" Text="HUD" Style="{StaticResource ColumnHeaderStyle}"/>
                                            <TextBlock Grid.Column="4" Text="角色" Style="{StaticResource ColumnHeaderStyle}"/>
                                            <TextBlock Grid.Column="5" Text="热键" Style="{StaticResource ColumnHeaderStyle}"/>
                                            <TextBlock Grid.Column="6" Text="宏" Style="{StaticResource ColumnHeaderStyle}"/>
                                            <TextBlock Grid.Column="7" Text="肖像" Style="{StaticResource ColumnHeaderStyle}"/>
                                            <TextBlock Grid.Column="8" Text="物品" Style="{StaticResource ColumnHeaderStyle}"/>
                                            <TextBlock Grid.Column="9" Text="消息" Style="{StaticResource ColumnHeaderStyle}"/>
                                            <TextBlock Grid.Column="10" Text="记录" Style="{StaticResource ColumnHeaderStyle}"/>
                                            <TextBlock Grid.Column="11" Text="幻卡" Style="{StaticResource ColumnHeaderStyle}"/>
                                            <TextBlock Grid.Column="12" Text="其他" Style="{StaticResource ColumnHeaderStyle}"/>
                                        </Grid>
                                         <Border BorderBrush="{DynamicResource ListSeparatorBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="BackupEmptyText" Text="尚未扫描角色。选择目录后点击“扫描角色”。"
                                                   Style="{StaticResource SmallMutedTextStyle}" Margin="0,14,0,8"/>
                                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="BackupCharactersList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource ListSeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="34"/>
                                                                    <ColumnDefinition Width="250"/>
                                                                    <ColumnDefinition Width="110"/>
                                                                    <ColumnDefinition Width="62"/>
                                                                    <ColumnDefinition Width="62"/>
                                                                    <ColumnDefinition Width="62"/>
                                                                    <ColumnDefinition Width="62"/>
                                                                    <ColumnDefinition Width="62"/>
                                                                    <ColumnDefinition Width="62"/>
                                                                    <ColumnDefinition Width="62"/>
                                                                    <ColumnDefinition Width="62"/>
                                                                    <ColumnDefinition Width="62"/>
                                                                    <ColumnDefinition Width="62"/>
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                          VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding DisplayName}"
                                                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                                   MaxWidth="180" VerticalAlignment="Center"/>
                                                                        <Button Content="备注" Tag="{Binding}"
                                                                                Style="{StaticResource GhostButtonStyle}"
                                                                                Click="EditAlias_Click" Margin="4,0,0,0"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding DetailLine}"
                                                                               Style="{StaticResource SmallMutedTextStyle}"
                                                                               TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2" Text="{Binding LastActiveText}"
                                                                           Style="{StaticResource SmallMutedTextStyle}"
                                                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                <CheckBox Grid.Column="3" IsChecked="{Binding IncludeHud, Mode=TwoWay}"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                          ToolTip="界面/HUD：ADDON.DAT"/>
                                                                <CheckBox Grid.Column="4" IsChecked="{Binding IncludeCharacter, Mode=TwoWay}"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                          ToolTip="角色设置：COMMON.DAT / CONTROL0.DAT / CONTROL1.DAT"/>
                                                                <CheckBox Grid.Column="5" IsChecked="{Binding IncludeHotbar, Mode=TwoWay}"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                          ToolTip="热键与键位：HOTBAR.DAT / KEYBIND.DAT"/>
                                                                <CheckBox Grid.Column="6" IsChecked="{Binding IncludeMacro, Mode=TwoWay}"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                          ToolTip="用户宏：MACRO.DAT"/>
                                                                <CheckBox Grid.Column="7" IsChecked="{Binding IncludePortrait, Mode=TwoWay}"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                          ToolTip="套装与肖像：GEARSET.DAT + UISAVE.DAT"/>
                                                                <CheckBox Grid.Column="8" IsChecked="{Binding IncludeInventory, Mode=TwoWay}"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                          ToolTip="物品与雇员顺序：ITEMFDR.DAT / ITEMODR.DAT"/>
                                                                <CheckBox Grid.Column="9" IsChecked="{Binding IncludeChatSettings, Mode=TwoWay}"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                          ToolTip="消息窗口设置：LOGFLTR.DAT"/>
                                                                 <CheckBox Grid.Column="10" IsChecked="{Binding IncludeChatHistory, Mode=TwoWay}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           ToolTip="聊天记录与最近悄悄话：log/ 与 ACQ.DAT"/>
                                                                <CheckBox Grid.Column="11" IsChecked="{Binding IncludeGoldSaucer, Mode=TwoWay}"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                          ToolTip="九宫幻卡：GS.DAT"/>
                                                                <CheckBox Grid.Column="12" IsChecked="{Binding IncludeOther, Mode=TwoWay}"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                          ToolTip="未识别文件"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource InfoBorderStyle}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox x:Name="IncludeSystemSettingsCheckBox" IsChecked="True"
                                                      Content="备份系统设置"/>
                                            <TextBlock Style="{StaticResource SmallMutedTextStyle}" Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Text="仅同步声音、字体、鼠标、UI、过场和手柄按键；显示与画面设置保持不变。"/>
                                        </StackPanel>
                                        <CheckBox x:Name="IncludeSharedMacroCheckBox" IsChecked="True" Margin="0,8,0,0"
                                                  Content="备份公用宏"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="3. 生成备份" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="保存文件夹" Style="{StaticResource SmallMutedTextStyle}" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BackupSaveDirectoryBox" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Content="选择文件夹" Style="{StaticResource SecondaryButtonStyle}"
                                            Click="BrowseBackupDirectory_Click"/>
                                </Grid>
                                <TextBlock Text="备份文件名" Style="{StaticResource SmallMutedTextStyle}" Margin="0,12,0,5"/>
                                <Grid>
                                    <TextBox x:Name="BackupFileNameBox" TextChanged="BackupFileNameBox_TextChanged"/>
                                    <TextBlock x:Name="BackupFileNameHint" IsHitTestVisible="False"
                                               Style="{StaticResource InputHintTextStyle}"
                                                Text="FF14_时间戳"/>
                                </Grid>
                                <CheckBox x:Name="PortablePackageCheckBox" Margin="0,12,0,0"
                                          Content="备份与工具一起打包"/>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="StartBackupButton" Content="开始备份"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="StartBackup_Click"/>
                                    <Button x:Name="CancelBackupButton" Grid.Column="1" Content="取消"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="CancelBackup_Click" Visibility="Collapsed" Margin="8,0,0,0"/>
                                    <ProgressBar x:Name="BackupProgressBar" Grid.Column="2" Margin="14,0,0,0"
                                                 Value="0" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="BackupStatusText" Visibility="Collapsed"/>
                                <TextBlock x:Name="BackupResultText" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="RestorePage" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,10,0,10">

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="选择路径" Style="{StaticResource SectionTitleStyle}"/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="备份文件" VerticalAlignment="Center"
                                               Style="{StaticResource SmallMutedTextStyle}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="RestoreArchivePathBox" Margin="0,0,8,0"/>
                                    <Button Grid.Row="0" Grid.Column="2" Content="浏览..." Style="{StaticResource SecondaryButtonStyle}"
                                            Click="BrowseArchive_Click" Margin="0,0,8,0"/>
                                    <Button Grid.Row="0" Grid.Column="3" Content="读取备份" Style="{StaticResource PrimaryButtonStyle}"
                                            Click="LoadArchive_Click"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="游戏目录" VerticalAlignment="Center"
                                               Style="{StaticResource SmallMutedTextStyle}" Margin="0,12,0,0"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="RestoreGamePathBox" Margin="0,12,8,0"/>
                                    <Button Grid.Row="1" Grid.Column="2" Content="浏览..." Style="{StaticResource SecondaryButtonStyle}"
                                            Click="BrowseRestoreGamePath_Click" Margin="0,12,8,0"/>
                                    <Button Grid.Row="1" Grid.Column="3" Content="扫描目标" Style="{StaticResource PrimaryButtonStyle}"
                                            Click="ScanTarget_Click" Margin="0,12,0,0"/>
                                </Grid>
                                <TextBlock x:Name="ArchiveSummaryText" Visibility="Collapsed"/>
                                <TextBlock x:Name="ArchiveDetailText" Visibility="Collapsed"/>
                                <TextBlock x:Name="RestoreConfigPathText" Visibility="Collapsed"/>
                                <Border x:Name="ElevationPanel" Style="{StaticResource WarningBorderStyle}"
                                        Margin="0,10,0,0" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ElevationText" Style="{StaticResource SmallMutedTextStyle}"
                                                    Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="以管理员身份重启"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="RelaunchAsAdmin_Click" Margin="10,0,0,0"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="角色映射" Style="{StaticResource SectionTitleStyle}"/>
                                <Border x:Name="CrossWarningBorder" Style="{StaticResource WarningBorderStyle}"
                                        Margin="0,10,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="CrossWarningText" Style="{StaticResource StatusTextStyle}"
                                                Foreground="{DynamicResource WarningBrush}"/>
                                </Border>

                                <Grid Margin="0,10,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="300"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="备份中的角色" Style="{StaticResource ColumnHeaderStyle}"
                                               HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="3" Text="目标角色" Style="{StaticResource ColumnHeaderStyle}"
                                               HorizontalAlignment="Left"/>
                                </Grid>
                                 <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                         CornerRadius="8" Background="{DynamicResource ListBackgroundBrush}" Padding="10">
                                    <StackPanel>
                                        <TextBlock x:Name="RestoreEmptyText" Text="读取备份并扫描目标目录后显示角色映射。"
                                                   Style="{StaticResource SmallMutedTextStyle}" Margin="0,6,0,6"/>
                                        <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="RestoreMappingsList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                         <Border BorderBrush="{DynamicResource ListSeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="34"/>
                                                                    <ColumnDefinition Width="300"/>
                                                                    <ColumnDefinition Width="30"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                          VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                                    <TextBlock Text="{Binding SourceName}" FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                                                                    <TextBlock Text="{Binding SourceDetail}"
                                                                               Style="{StaticResource SmallMutedTextStyle}"
                                                                               TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2" Text="→" FontSize="18"
                                                                             Foreground="{DynamicResource SecondaryTextBrush}"
                                                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                                    <ComboBox ItemsSource="{Binding TargetOptions}"
                                                                              SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                                                                              DisplayMemberPath="Label" Width="430"
                                                                              VerticalAlignment="Center"/>
                                                                    <Border CornerRadius="4" Padding="6,3" Margin="8,0,0,0"
                                                                            VerticalAlignment="Center">
                                                                        <Border.Style>
                                                                            <Style TargetType="{x:Type Border}">
                                                                                <Setter Property="Background" Value="#F2F4F7"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsCrossCharacter}" Value="True">
                                                                                        <Setter Property="Background" Value="#FFF7E8"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock Text="{Binding CrossBadge}" FontSize="11">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="{x:Type TextBlock}">
                                                                                     <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsCrossCharacter}" Value="True">
                                                                                             <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="添加目标角色" Style="{StaticResource GhostButtonStyle}"
                                                    Click="AddTargetCharacter_Click" Margin="0,0,8,0"/>
                                            <Button Content="全部按同 ID 匹配" Style="{StaticResource GhostButtonStyle}"
                                                    Click="ResetMappings_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="StartRestoreButton" Content="开始恢复"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="StartRestore_Click"/>
                                    <Button x:Name="RestoreChangesButton" Grid.Column="1" Content="还原更改"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="RestoreChanges_Click" IsEnabled="False"
                                            Margin="8,0,0,0"/>
                                    <ProgressBar x:Name="RestoreProgressBar" Grid.Column="2" Margin="14,0,0,0"
                                                 Value="0" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="RestoreStatusText" Visibility="Collapsed"/>
                                <TextBlock x:Name="RestoreResultText" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
